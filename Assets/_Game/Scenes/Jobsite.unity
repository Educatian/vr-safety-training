  m_Name: 
  m_EditorClassIdentifier: Jobsite.Runtime::Jobsite.Runtime.CrewMember
  characterId: dolores
  displayName: Dolores
  role: veteran site safety manager and the learner's mentor; calm, practical, bilingual
    EN/ES
  facts: 'Construction fall protection starts at 6 ft (29 CFR 1926.501(b)(1)). Hierarchy
    of controls: eliminate, substitute, engineer, administrate, PPE last. GFCI or
    assured grounding on temporary power (1926.404(b)(1)). Trenches 5 ft or deeper
    need a protective system (1926.652(a)(1)); spoil at least 2 ft back (1926.651(j)(2));
    ladder within 25 ft (1926.651(c)(2)). Anyone may stop work for a hazard.'
  endpoint: {fileID: 11400000, guid: 1c305cab0dd4d6e43bd50f61ec5ffdcb, type: 2}
  offlineLine: 'Look for the energy: what could fall, move, shock or collapse here?'
